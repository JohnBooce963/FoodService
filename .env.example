# Copy to .env and fill in. Neon: Dashboard -> Connect, paste the string as is (a JDBC URL works too).
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Password for the shop's order screen (8+ characters). Login is off without it.
SHOP_PASSWORD=
# Frontend origin(s), comma separated. Defaults to * (no cookies are used).
CORS_ORIGINS=http://localhost:4200
